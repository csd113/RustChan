# Playwright browser tests: the maintained harness source is tracked
# (playwright.config.ts, package.json, package-lock.json, tests/e2e/**,
# .github/workflows/e2e.yml). Generated run evidence, browser state, npm
# caches, and runtime output stay ignored below.
/output/
playwright-report/
test-results/
blob-report/
browser-report/
browser-artifacts/
.playwright/
.playwright-cli/
.playwright-mcp/
.auth/
/browser-results.json
/browser-summary.json
/browser-versions.json
/instance.json
/*-instance.json
/storage-state*.json
/storageState*.json
/*browser-state*.json
/screenshots/
/videos/
/traces/
/downloads/
/audit-output/
/audit-reports/
/.codex-pet-runs/

# Local task handoff referencing ignored browser evidence and temporary logs.
# Keep published security records and maintained policy ledgers in docs tracked.
/docs/theme-system-audit-2026-09-06.md


# OS metadata and editor scratch files.
.DS_Store
._*
Thumbs.db
Desktop.ini
.idea/
*.swp
*.swo
*~
*.orig
*.rej

# Build output, dependency caches, coverage, and profiling output.
target/
/dist/
/build/
/coverage/
/lcov.info
/tarpaulin-report.*
*.profraw
*.profdata
/flamegraph.svg
/perf.data*
/criterion/
# Binaries copied out of target/ and their macOS debug bundles.
/rustchan-cli
/rustchan-cli.exe
/rustchan-cli.dSYM/
__pycache__/
*.py[cod]
/.venv/
/.pytest_cache/
/.mypy_cache/
/.ruff_cache/
/.cache/

# Logs, process state, and temporary files.
*.log
*.log.*
*.pid
*.pid.lock
*.sock
*.socket
*.tmp
*.temp
*.bak
/tmp/
/temp/
/.tmp*/
/core
/core.[0-9]*
/rustchan-cli*.dmp

# Generated evidence and release staging outputs.
/output/
/audit-output/
/audit-reports/
/.codex-pet-runs/
/RELEASE_NOTES.md
/release-assets/
# End generated evidence.

# RustChan runtime trees (also next to copied binaries) and disposable instances.
rustchan-data/
/runtime/
/runtimes/
/uploads/
/boards/
/backups/
/backup-*/
/restore-*/
/extracted-*/
/logs/
/tls/
/tor/
/certs/

# Loose runtime data, backups, and keys at the repository root.
# Root anchoring keeps deliberately versioned fixtures/examples trackable.
/settings.toml
/*.db
/*.db-*
/*.sqlite
/*.sqlite-*
/*.sqlite3
/*.sqlite3-*
/*.zip
/*.tar
/*.tar.*
/*.tgz
/*.7z
/*.pem
/*.crt
/*.cer
/*.key
/*.p12
/*.pfx
/id_rsa
/id_ed25519
/hs_ed25519_*
/cookies.txt
/*.cookies

# Local secrets; sanitized environment examples remain eligible for tracking.
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.*.sample
!.env.template
!.env.*.template
/secrets/
/.secrets/
/.netrc
/.cargo/credentials
/.cargo/credentials.toml

# Local AI tooling: keep instructions, configuration, and sessions on this machine.
# CI checks this block even if an ignored file is accidentally force-added.
AGENTS.md
CLAUDE.md
GEMINI.md
.agents/
.codex/
.claude/
.cursor/
.continue/
.windsurf/
.aider*
/.mcp.json
/mcp.json
/.cursorrules
/.windsurfrules
/.github/copilot-instructions.md
/.github/instructions/
/.github/prompts/
/rules.md
# End local AI tooling.

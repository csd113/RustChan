{
  "name": "rustchan-e2e",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --project=chromium --workers=2 --max-failures=5",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox-nojs": "playwright test --project=firefox-nojs",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:console": "playwright test tests/e2e/console-headless.spec.ts tests/e2e/helpers-lifecycle.spec.ts --project=chromium",
    "test:e2e:media": "node tests/e2e/media-toolchain-check.mjs --self-test && node tests/e2e/media-toolchain-check.mjs && RUSTCHAN_E2E_MEDIA_TOOLCHAIN=1 playwright test tests/e2e/media-toolchain.spec.ts --project=chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0"
  }
}

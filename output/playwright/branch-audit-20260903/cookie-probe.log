### Ran Playwright code
```js
await (async page => {
  const base = 'http://127.0.0.1:62305';
  const context = page.context();
  const checks = [];
  const check = (name, condition) => { if (!condition) throw new Error(name); checks.push(name); };
  const before = await context.cookies(base);
  const admin = before.find(c => c.name === 'chan_admin_session');
  check('admin session issued for HTTP with HttpOnly and SameSite=Lax', admin && admin.httpOnly && !admin.secure && admin.sameSite === 'Lax');
  await context.addCookies([{ name: 'audit_unrelated', value: 'preserve-me', url: base }]);
  await context.clearCookies({ name: 'csrf_token' });
  await page.goto(base + '/audit');
  const first = await context.cookies(base);
  const csrf = first.find(c => c.name === 'csrf_token');
  check('fresh public navigation creates a CSRF cookie', csrf && csrf.value.length > 20);
  check('unrelated cookie survives CSRF generation', first.find(c => c.name === 'audit_unrelated')?.value === 'preserve-me');
  check('admin cookie survives CSRF generation unchanged', first.find(c => c.name === 'chan_admin_session')?.value === admin.value);
  const token = await page.locator('form[action="/audit"] input[name="_csrf"]').inputValue();
  await page.goto(base + '/audit/catalog');
  await page.goto(base + '/audit/thread/1');
  const second = await context.cookies(base);
  check('existing CSRF token is stable across navigation', second.find(c => c.name === 'csrf_token')?.value === csrf.value);
  const good = await page.request.post(base + '/preferences', { form: { _csrf: token, theme: 'blue-sky', return_to: '/audit' }, maxRedirects: 0 });
  check('earlier public CSRF form remains valid', good.status() === 303);
  for (const value of ['', 'invalid']) {
    const bad = await page.request.post(base + '/preferences', { form: { _csrf: value, theme: 'terminal', return_to: '/audit' }, maxRedirects: 0 });
    check('reject public CSRF ' + (value || 'missing'), bad.status() === 403);
  }
  await page.goto(base + '/admin/panel');
  check('admin session still grants panel access after CSRF regeneration', page.url().includes('/admin/panel') && await page.getByRole('button', { name: 'logout', exact: true }).isVisible());
  const badContext = await context.browser().newContext();
  try {
    await badContext.addCookies([{ name: 'chan_admin_session', value: 'invalid-session', url: base }]);
    const response = await badContext.request.get(base + '/admin/panel', { maxRedirects: 0 });
    check('invalid session denied', [302, 303, 403].includes(response.status()));
  } finally { await badContext.close(); }
  console.log(JSON.stringify({ status: 'PASS', checks }, null, 2));
}
)(page);
```
### Page
- Page URL: http://127.0.0.1:62305/admin/panel
- Page Title: admin panel
